{
  "name": "dsh-studio-travel",
  "version": "0.2.0",
  "description": "StarMap：地球足迹、国家城市、路线、相册与旅程时间线",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "static",
    "upstream",
    "patches",
    "app",
    "studio.json",
    "sources.json",
    "UPSTREAM.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "experimental"
      }
    }
  },
  "peerDependencies": {
    "dsh-studio-projects": "^0.5.0",
    "dsh-worktable": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "dsh-studio-projects": {
      "optional": true
    },
    "dsh-worktable": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs travel"
  },
  "dependencies": {
    "sharp": "0.35.3",
    "undici": "8.10.0",
    "world-countries": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-studio-travel.git",
    "directory": "studios/travel"
  },
  "homepage": "https://github.com/1997liuyh-boop/dsh-studio-travel#readme",
  "bugs": {
    "url": "https://github.com/1997liuyh-boop/dsh-studio-travel/issues"
  }
}
